# Copy to .env (gitignored) and fill in. Never commit .env. Every variable is described in contracts/README.md.
# The placeholders below are enough for `docker compose up` to start; PayPal and OpenAI keys are needed from S1/S2.

# PayPal SANDBOX only (developer.paypal.com > Apps & Credentials > Sandbox). Never live credentials.
# Roaster's sandbox REST app:
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# One shared sandbox merchant for every SIMULATED supplier:
PAYPAL_SIM_CLIENT_ID=your-sandbox-sim-client-id
PAYPAL_SIM_CLIENT_SECRET=your-sandbox-sim-client-secret
# Sandbox personal (buyer) account that receives and pays invoices:
PAYPAL_SANDBOX_BUYER_EMAIL=sb-buyer@personal.example.com

# OpenAI (platform.openai.com > API keys)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-6-luna

# Local infrastructure. Any values work; change them if you expose the stack beyond localhost.
POSTGRES_PASSWORD=change-me-postgres
ELASTIC_PASSWORD=change-me-elastic
# Demo login for every desk (username = desk id: cafe, roaster)
DESK_DEMO_PASSWORD=change-me-demo

# The SIMULATED malicious supplier (S8): "Totally Legit Beans" sends a prompt-injected $40/kg quote that the café's Java
# policy engine blocks. Delete or empty the COMPOSE_PROFILES line to switch it off: the supplier is not started and the
# café does not ask it, so the rest of the demo is unchanged. An existing database volume needs `docker compose down -v`
# once after you pull this, because the new supplier's database is only created on a fresh volume.
COMPOSE_PROFILES=malicious
# Optional second variant of the attack: its quote also carries "autoApprove": true, which the café refuses whole.
DESK_MALICIOUS_EXTRA_FIELD=false
