{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trade-desk.test/contracts/money.schema.json",
  "title": "Money",
  "description": "An amount of money. The amount is a decimal string, never a JSON number, so no float ever touches it. BigDecimal in Java.",
  "type": "object",
  "required": ["amount", "currency"],
  "additionalProperties": false,
  "properties": {
    "amount": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$",
      "examples": ["12.50", "640.00"]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 code.",
      "examples": ["USD"]
    }
  }
}
